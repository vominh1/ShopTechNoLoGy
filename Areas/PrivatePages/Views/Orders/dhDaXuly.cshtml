@using ShopTechNoLoGy.Models
@{
    ViewBag.Title = "Đơn hàng đã duyệt";
    List<donHang> ds = ViewData["DanhSachDonHang"] as List<donHang>;
}

<style>
    body {
        background-color: #f8f9fa;
    }

    .page-header {
        background: linear-gradient(135deg, #0d6efd, #0dcaf0);
        padding: 1.5rem 0;
        margin-bottom: 2rem;
        color: white;
        border-radius: 0 0 15px 15px;
    }

    .card {
        border: none;
        border-radius: 15px;
        box-shadow: 0 0 20px rgba(0,0,0,0.05);
        transition: transform 0.2s ease;
    }

    .table-container {
        border-radius: 15px;
        overflow: hidden;
    }

    .table {
        margin-bottom: 0;
    }

        .table thead th {
            background-color: #f8f9fa;
            border-bottom: 2px solid #dee2e6;
            color: #495057;
            font-weight: 600;
            padding: 1rem;
        }

        .table tbody td {
            padding: 1rem;
            vertical-align: middle;
        }

    .table-hover tbody tr:hover {
        background-color: rgba(13, 110, 253, 0.05);
        transition: background-color 0.3s ease;
    }

    .btn-custom {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1rem;
        border-radius: 8px;
        font-weight: 500;
        transition: all 0.3s ease;
    }

        .btn-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }

    .btn-warning {
        background-color: #ffc107;
        border-color: #ffc107;
        color: #000;
    }

    .btn-danger {
        background-color: #dc3545;
        border-color: #dc3545;
        color: #fff;
    }

    .btn-info {
        background-color: #0dcaf0;
        border-color: #0dcaf0;
        color: #fff;
    }

    .badge {
        padding: 0.5rem 1rem;
        border-radius: 6px;
        font-weight: 500;
    }

    .empty-state {
        padding: 3rem;
        text-align: center;
        color: #6c757d;
    }

    .breadcrumb {
        background: transparent;
        margin-bottom: 0;
    }

    .breadcrumb-item a {
        color: rgba(255, 255, 255, 0.8);
        text-decoration: none;
    }

    .breadcrumb-item.active {
        color: white;
    }
</style>

<div class="page-header">
    <div class="container-fluid">
        <div class="row align-items-center">
            <div class="col-sm-6">
                <h1 class="h3 mb-2">Danh sách đơn hàng đã duyệt</h1>
            </div>
            <div class="col-sm-6">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb float-sm-end mb-0">
                        <li class="breadcrumb-item"><a href="#">Quản trị</a></li>
                        <li class="breadcrumb-item active">Danh sách đơn hàng đã duyệt</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="card">
        <div class="card-body p-0">
            <div class="table-container">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Số đơn hàng</th>
                            <th>Mã khách hàng</th>
                            <th>Trạng thái</th>
                            <th>Ngày đặt</th>
                            <th>Họ & tên</th>
                            <th>Địa chỉ giao hàng</th>
                            <th class="text-end">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ds != null && ds.Any())
                        {
                            foreach (var order in ds)
                            {
                                <tr>
                                    <td><strong>#@order.soDH</strong></td>
                                    <td>@order.maKH</td>
                                    <td>
                                        <span class="badge bg-warning">
                                            Đã duyệt
                                        </span>
                                    </td>
                                    <td>@order.ngayDat</td>
                                    <td>@order.taiKhoanTV.hoDem @order.taiKhoanTV.tenTV</td>
                                    <td>@order.diaChiGH</td>
                                    <td class="text-end">
                                        <div class="btn-group">
                                            @using (Html.BeginForm("Active", "Customer", FormMethod.Post, new { @class = "d-inline me-1" }))
                                            {
                                                <input type="hidden" name="maDonHang" value="@order.soDH" />
                                                <button class="btn btn-warning btn-custom" title="Cấm đơn hàng">
                                                    <i class="fas fa-ban"></i> Ẩn
                                                </button>
                                            }
                                         
                                            @using (Html.BeginForm("OrderDetailsT", "Orders", FormMethod.Post, new { @class = "d-inline" }))
                                            {
                                                <input type="hidden" name="maDonHang" value="@order.soDH" />
                                                <button class="btn btn-info btn-custom" title="Xem chi tiết đơn hàng">
                                                    <i class="fas fa-info-circle"></i> Chi tiết
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6">
                                    <div class="empty-state">
                                        <i class="fas fa-inbox fa-3x mb-3"></i>
                                        <h5>Không có đơn hàng nào để hiển thị</h5>
                                        <p class="text-muted">Danh sách đơn hàng đã duyệt sẽ xuất hiện tại đây</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">