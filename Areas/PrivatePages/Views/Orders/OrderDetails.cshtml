@model ShopTechNoLoGy.Models.OrderDetailsModel
@{
    ViewBag.Title = "Chi Tiết Đơn Hàng";
    Layout = "~/Areas/PrivatePages/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white py-3">
            <h2 class="text-center mb-0">Chi Tiết Đơn Hàng</h2>
        </div>

        <div class="card-body">
            @if (Model == null)
            {
                <div class="alert alert-warning d-flex align-items-center" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <div>Không có đơn hàng nào.</div>
                </div>
            }
            else
            {
                <div class="row mb-4">
                    <div class="col-md-6">
                        <div class="d-flex align-items-center mb-3">
                            <h3 class="mb-0">Đơn hàng: <span class="badge bg-primary">@Model.soDH</span></h3>
                        </div>
                        <p class="text-muted">
                            <i class="bi bi-calendar3 me-2"></i>
                            <strong>Ngày đặt:</strong> @Model.NgayDat.ToShortDateString()
                        </p>
                    </div>
                </div>

                <div class="card mb-4 border-0 bg-light">
                    <div class="card-header bg-secondary text-white">
                        <h4 class="mb-0">
                            <i class="bi bi-person-circle me-2"></i>
                            Thông tin khách hàng
                        </h4>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <p><i class="bi bi-person me-2"></i><strong>Tên khách hàng:</strong> @Model.TenKH</p>
                                <p><i class="bi bi-telephone me-2"></i><strong>Số điện thoại:</strong> @Model.SoDt</p>
                            </div>
                            <div class="col-md-6">
                                <p><i class="bi bi-geo-alt me-2"></i><strong>Địa chỉ:</strong> @Model.DiaChi</p>
                                <p><i class="bi bi-envelope me-2"></i><strong>Email:</strong> @Model.Email</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mb-4 border-0">
                    <div class="card-header bg-secondary text-white">
                        <h4 class="mb-0">
                            <i class="bi bi-cart-check me-2"></i>
                            Chi tiết sản phẩm
                        </h4>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Mã SP</th>
                                        <th>Tên Sản Phẩm</th>
                                        <th class="text-center">Số Lượng</th>
                                        <th class="text-end">Giá Bán</th>
                                        <th class="text-end">Giảm Giá</th>
                                        <th class="text-end">Thành Tiền</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.OrderItems)
                                    {
                                        <tr>
                                            <td>@item.MaSP</td>
                                            <td>@item.TenSP</td>
                                            <td class="text-center">@item.SoLuong</td>
                                            <td class="text-end">@string.Format("{0:#,##0 VNĐ}", item.GiaBan)</td>
                                            <td class="text-end">@string.Format("{0:#,##0 VNĐ}", item.GiamGia)</td>
                                            <td class="text-end">@string.Format("{0:#,##0 VNĐ}", item.ThanhTien)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="card bg-light border-0">
                    <div class="card-body">
                        <div class="d-flex justify-content-end align-items-center">
                            <h4 class="mb-0">
                                Tổng thành tiền:
                                <span class="text-danger fw-bold">@string.Format("{0:#,##0 VNĐ}", Model.TongThanhTien)</span>
                            </h4>
                        </div>
                    </div>
                </div>
            }

            <div class="text-center mt-4">
                <a href="@Url.Action("Index", "Orders")" class="btn btn-primary">
                    <i class="bi bi-arrow-left me-2"></i>Quay lại danh sách đơn hàng
                </a>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.7.2/font/bootstrap-icons.css">