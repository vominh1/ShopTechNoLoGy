@using ShopTechNoLoGy.Models
@{
    ViewBag.Title = "Danh sách đơn hàng";
    List<donHang> ds = ViewData["DanhSachDonHang1"] as List<donHang>;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>@ViewBag.Title</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet">
    <style>
        :root {
            --primary-color: #007bff;
            --secondary-color: #6c757d;
            --success-color: #28a745;
            --danger-color: #dc3545;
            --info-color: #17a2b8;
        }

        body {
            background-color: #f4f6f9;
            font-family: 'Inter', 'Segoe UI', Roboto, sans-serif;
            line-height: 1.4;
        }

        .order-header {
            background: linear-gradient(135deg, var(--primary-color), #5a9bd5);
            color: white;
            padding: 1rem 0;
            margin-bottom: 1.5rem;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }

        .order-card {
            border-radius: 10px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.08);
        }

        .table-order {
            margin-bottom: 0;
        }

        .table-order thead {
            background-color: #f1f3f5;
            color: #2c3e50;
        }

        .table-order th, .table-order td {
            vertical-align: middle;
            padding: 0.65rem;
            font-size: 0.9rem;
        }

        .btn-action {
            display: inline-flex;
            align-items: center;
            gap: 0.3rem;
            padding: 0.3rem 0.7rem;
            margin: 0.1rem;
            font-size: 0.8rem;
        }

        .btn-action i {
            margin-right: 0.2rem;
            font-size: 0.7rem;
        }

        .card-footer {
            background-color: #f8f9fa;
            border-top: 1px solid #e9ecef;
            text-align: center;
            padding: 0.7rem;
            font-size: 0.8rem;
            color: var(--secondary-color);
        }

       
    </style>
</head>
<body>
    <section class="order-header">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <h1 class="mb-0" style="font-size: 1.5rem;">Danh sách đơn hàng của bạn</h1>
                </div>
            </div>
        </div>
    </section>

    <section class="content">
        <div class="container">
            <div class="card order-card">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover table-order mb-0">
                            <thead>
                                <tr>
                                    <th>Số đơn hàng</th>
                                    <th>Mã KH</th>
                                    <th>Trạng thái</th>
                                    <th>Ngày Đặt</th>
                                    <th>Tài Khoản</th>
                                    <th>Địa chỉ</th>
                                    <th>Hành động</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (ds != null && ds.Count > 0)
                                {
                                    foreach (var order in ds)
                                    {
                                        <tr>
                                            <td>@order.soDH</td>
                                            <td>@order.maKH</td>
                                            <td><span class="badge bg-warning text-dark">Chưa duyệt</span></td>
                                            <td>@order.ngayDat</td>
                                            <td>@order.taiKhoan</td>
                                            <td>@order.diaChiGH</td>
                                            <td>
                                                @using (Html.BeginForm("Active", "Orders", FormMethod.Post, new { @class = "d-inline" }))
                                                {
                                                    <input type="hidden" name="maDonHang" value="@order.soDH" />
                                                    <button class="btn btn-success btn-action" title="Kích hoạt">
                                                        <i class="fas fa-check"></i> Kích hoạt
                                                    </button>
                                                }
                                                @using (Html.BeginForm("Delete", "Orders", FormMethod.Post, new { @class = "d-inline" }))
                                                {
                                                    <input type="hidden" name="maDonHang" value="@order.soDH" />
                                                    <button class="btn btn-danger btn-action" title="Từ chối">
                                                        <i class="fas fa-trash"></i> Từ chối
                                                    </button>
                                                }
                                                @using (Html.BeginForm("OrderDetails", "Orders", FormMethod.Post, new { @class = "d-inline" }))
                                                {
                                                    <input type="hidden" name="maDonHang" value="@order.soDH" />
                                                    <button class="btn btn-info btn-action" title="Chi tiết">
                                                        <i class="fas fa-info-circle"></i> Chi tiết
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="7" class="text-center">Không có đơn hàng nào để hiển thị.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer">
                    <p class="mb-0">© 2024 ShopTechNoLoGy</p>
                </div>
            </div>
        </div>
    </section>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
</body>
</html>