@model IEnumerable<ShopTechNoLoGy.Models.DoanhThuThangModel>
@{
    ViewBag.Title = "So sánh doanh thu tháng";
    Layout = "~/Areas/PrivatePages/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
    <div class="container">
        <h4 class="display-7">So sánh doanh thu theo tháng</h4>
    </div>
</div>

<div class="container">
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">

            <h5 class="card-title mb-0">Chọn tháng để so sánh</h5>
            <button id="toggleSSButton" class="btn btn-light btn-sm ">
                <i class="fas fa-table"></i> Ẩn/Hiện bảng
            </button>
        </div>
        <div class="card-body bg-light p-4" id="SSContent">
            <div class="row g-4">
                <!-- Tháng thứ nhất -->
                <div class="col-md-6">
                    <div class="bg-white p-4 rounded-3 shadow-sm h-100">
                        <h6 class="text-primary border-bottom pb-2 mb-4">
                            <i class="fas fa-calendar-alt me-2"></i>Tháng thứ nhất
                        </h6>
                        <div class="row g-3">
                            <div class="col-sm-6">
                                <div class="form-group">
                                    <label class="form-label fw-medium mb-2">Tháng:</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-primary text-white">
                                            <i class="fas fa-calendar-day"></i>
                                        </span>
                                        <select id="thang1" class="form-select">
                                            @for (int i = 1; i <= 12; i++)
                                            {
                                                <option value="@i">Tháng @i</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="form-group">
                                    <label class="form-label fw-medium mb-2">Năm:</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-primary text-white">
                                            <i class="fas fa-calendar-year"></i>
                                        </span>
                                        <select id="nam1" class="form-select">
                                            @for (int i = DateTime.Now.Year - 5; i <= DateTime.Now.Year; i++)
                                            {
                                                <option value="@i">Năm @i</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tháng thứ hai -->
                <div class="col-md-6">
                    <div class="bg-white p-4 rounded-3 shadow-sm h-100">
                        <h6 class="text-primary border-bottom pb-2 mb-4">
                            <i class="fas fa-calendar-alt me-2"></i>Tháng thứ hai
                        </h6>
                        <div class="row g-3">
                            <div class="col-sm-6">
                                <div class="form-group">
                                    <label class="form-label fw-medium mb-2">Tháng:</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-primary text-white">
                                            <i class="fas fa-calendar-day"></i>
                                        </span>
                                        <select id="thang2" class="form-select">
                                            @for (int i = 1; i <= 12; i++)
                                            {
                                                <option value="@i">Tháng @i</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="form-group">
                                    <label class="form-label fw-medium mb-2">Năm:</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-primary text-white">
                                            <i class="fas fa-calendar-year"></i>
                                        </span>
                                        <select id="nam2" class="form-select">
                                            @for (int i = DateTime.Now.Year - 5; i <= DateTime.Now.Year; i++)
                                            {
                                                <option value="@i">Năm @i</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Nút so sánh -->
            <div class="text-center mt-4">
                <button id="soSanhBtn" class="btn btn-primary btn-lg px-5 rounded-pill">
                    <i class="fas fa-chart-line me-2"></i>So sánh doanh thu
                </button>
            </div>
        </div>
    </div>

    <!-- Bảng dữ liệu -->
    <div class="card mb-4">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0">Bảng dữ liệu doanh thu</h5>
            <button id="toggleTableButton" class="btn btn-light btn-sm">
                <i class="fas fa-table"></i> Ẩn/Hiện bảng
            </button>
            <a href="@Url.Action("ExportMonthlyRevenueToExcel", "Revenue")" class="btn btn-success">
                <i class="fas fa-file-excel"></i> Xuất Excel
            </a>
        </div>
        <div id="tableContent" class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">Tháng</th>
                            <th scope="col">Năm</th>
                            <th scope="col">Doanh thu</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Thang</td>
                                <td>@item.Nam</td>
                                <td>@item.DoanhThu.ToString("C0")</td>
                                <td>
                                    <a href="@Url.Action("ChiTietDoanhThuNgaytrongthang", new { thang = item.Thang, nam = item.Nam })" class="btn btn-info btn-sm">
                                        Chi tiết
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Biểu đồ -->
    <div class="card">
        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0">Biểu đồ doanh thu</h5>
            <button id="toggleChartButton" class="btn btn-light btn-sm">
                <i class="fas fa-chart-bar"></i> Ẩn/Hiện biểu đồ
            </button>
        </div>
        <div id="chartContent" class="card-body">
            <canvas id="revenueChart" style="height: 400px;"></canvas>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    let currentChart = null;

    // Khởi tạo dữ liệu ban đầu
    const initialData = {
        labels: [@Html.Raw(string.Join(",", Model.Select(item => $"'Tháng {item.Thang}/{item.Nam}'")))],
        values: [@string.Join(",", Model.Select(item => item.DoanhThu))] // Giá trị doanh thu từ Model
    };

    // Hàm tạo biểu đồ
    function createChart(data, isComparison = false) {
        const ctx = document.getElementById('revenueChart').getContext('2d');

        if (currentChart) {
            currentChart.destroy();
        }

        const backgroundColor = isComparison ?
            ['rgba(54, 162, 235, 0.5)', 'rgba(255, 99, 132, 0.5)'] :
            'rgba(54, 162, 235, 0.5)';

        const borderColor = isComparison ?
            ['rgba(54, 162, 235, 1)', 'rgba(255, 99, 132, 1)'] :
            'rgba(54, 162, 235, 1)';

        currentChart = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: data.labels,
                datasets: [{
                    label: 'Doanh thu',
                    data: data.values,
                    backgroundColor: backgroundColor,
                    borderColor: borderColor,
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) {
                                return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(value);
                            }
                        }
                    }
                },
                plugins: {
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(context.raw);
                            }
                        }
                    }
                }
            }
        });
    }

    // Hàm cập nhật bảng dữ liệu
    function updateTable(data) {
        const tableBody = document.querySelector('.table tbody');
        tableBody.innerHTML = ''; // Xóa dữ liệu cũ

        data.forEach(item => {
            const row = document.createElement('tr');
            // Tách tháng và năm từ chuỗi "Tháng X/YYYY"
            const [thang, nam] = item.ThangNam.replace('Tháng ', '').split('/');

            row.innerHTML = `
                <td>${thang}</td>
                <td>${nam}</td>
                <td>${item.DoanhThu}</td>
            `;
            tableBody.appendChild(row);
        });
    }

    // Khởi tạo biểu đồ với dữ liệu ban đầu
    document.addEventListener('DOMContentLoaded', function() {
        createChart(initialData);

        // Xử lý ẩn hiện bảng và biểu đồ
        const tableContent = document.getElementById('tableContent');
        const chartContent = document.getElementById('chartContent');
        const toggleTableButton = document.getElementById('toggleTableButton');
        const toggleChartButton = document.getElementById('toggleChartButton');
        var toggleSSButton = document.getElementById('toggleSSButton');
        var SSContent = document.getElementById('SSContent');
        toggleTableButton.addEventListener('click', function() {
            tableContent.style.display = tableContent.style.display === 'none' ? 'block' : 'none';
        });

        toggleChartButton.addEventListener('click', function() {
            chartContent.style.display = chartContent.style.display === 'none' ? 'block' : 'none';
        });

        toggleSSButton.addEventListener('click', function () {
            SSContent.style.display = SSContent.style.display === 'none' ? 'block' : 'none';
        });
    });

    // Xử lý so sánh
    document.getElementById('soSanhBtn').addEventListener('click', function() {
        const thang1 = document.getElementById('thang1').value;
        const nam1 = document.getElementById('nam1').value;
        const thang2 = document.getElementById('thang2').value;
        const nam2 = document.getElementById('nam2').value;

        fetch(`/PrivatePages/Revenue/GetChonThangSoSanh?thang1=${thang1}&nam1=${nam1}&thang2=${thang2}&nam2=${nam2}`)
            .then(response => response.json())
            .then(data => {
                if (data.message) {
                    alert(data.message);
                    // Nếu có lỗi, hiển thị lại dữ liệu ban đầu
                    createChart(initialData);
                    return;
                }

                // Cập nhật bảng
                updateTable(data);

                // Cập nhật biểu đồ
                const comparisonData = {
                    labels: data.map(item => item.ThangNam),
                    values: data.map(item => parseFloat(item.DoanhThu.replace(/[^\d,-]/g, '').replace(',', '')))
                };

                createChart(comparisonData, true);
            })
            .catch(error => {
                console.error('Error:', error);
                // Nếu có lỗi, hiển thị lại dữ liệu ban đầu
                createChart(initialData);
            });
    });
</script>
