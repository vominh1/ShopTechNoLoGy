@model IEnumerable<ShopTechNoLoGy.Models.khachHangThanThietModel>

@{
    ViewBag.Title = "Khách Hàng Mua Nhiều Nhất";
}

<div class="container-fluid px-4 py-5">
    <div class="card shadow-lg">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h2 class="mb-0">
                <i class="fas fa-trophy me-3"></i>Danh Sách Tài Khoản Mua Nhiều Nhất
            </h2>
            <span class="badge bg-light text-primary">
                Tổng số khách hàng: @Model.Count()
            </span>
        </div>

        <div class="table-responsive">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="text-start">
                            <i class="fas fa-user-tag me-2"></i>Tên Tài Khoản
                        </th>
                        <th class="text-start">
                            <i class="fas fa-id-card me-2"></i>Họ Tên Khách Hàng
                        </th>
                        <th class="text-center">
                            <i class="fas fa-shopping-cart me-2"></i>Tổng Sản Phẩm
                        </th>
                        <th class="text-end">
                            <i class="fas fa-coins me-2"></i>Tổng Tiền (VND)
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.OrderByDescending(x => x.ThanhTien))
                    {
                        <tr>
                            <td class="text-start fw-bold">@item.MaKH</td>
                            <td class="text-start">@item.TenKH</td>
                            <td class="text-center">
                                <span class="badge bg-info text-white">@item.soluong</span>
                            </td>
                            <td class="text-end text-success fw-bold">
                                @item.ThanhTien.ToString("N0")
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="table-active">
                        <td colspan="2" class="text-end fw-bold">Tổng Cộng:</td>
                        <td class="text-center fw-bold">
                            @Model.Sum(x => x.soluong)
                        </td>
                        <td class="text-end text-primary fw-bold h5">
                            @Model.Sum(x => x.ThanhTien).ToString("N0")
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center p-5">
                <i class="fas fa-users-slash fa-4x text-muted mb-4"></i>
                <p class="h4 text-muted">Không có khách hàng nào</p>
            </div>
        }

        <div class="card-footer d-flex justify-content-between align-items-center">
            <small class="text-muted">
                <i class="fas fa-info-circle me-2"></i>Báo cáo được xuất vào @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
            </small>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css">
<style>
    body {
        background-color: #f4f6f9;
    }
</style>