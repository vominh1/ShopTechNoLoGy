@model IEnumerable<ShopTechNoLoGy.Models.chitietmua>

@{
    ViewBag.Title = "Chi Tiết Mua Hàng";
}

<div class="container-fluid px-4 py-5">
    <div class="card shadow-lg">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h2 class="mb-0">
                <i class="fas fa-shopping-bag me-3"></i>Chi Tiết Mua Hàng
            </h2>
            <span class="badge bg-light text-primary">
                Tổng sản phẩm: @Model.Count()
            </span>
        </div>

        <div class="table-responsive">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="text-start">
                            <i class="fas fa-tag me-2"></i>Tên Sản Phẩm
                        </th>
                        <th class="text-center">
                            <i class="fas fa-shopping-cart me-2"></i>Số Lượng
                        </th>
                        <th class="text-end">
                            <i class="fas fa-dollar-sign me-2"></i>Đơn Giá (VND)
                        </th>
                        <th class="text-end">
                            <i class="fas fa-coins me-2"></i>Tổng Tiền (VND)
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-start fw-bold">@item.TenSP</td>
                            <td class="text-center">@item.SoLuong</td>
                            <td class="text-end text-muted">@item.DonGia.ToString("N0")</td>
                            <td class="text-end text-success fw-bold">@item.ThanhTien.ToString("N0")</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="table-active">
                        <td colspan="3" class="text-end fw-bold">Tổng Cộng:</td>
                        <td class="text-end text-primary fw-bold h5">
                            @Model.Sum(x => x.ThanhTien).ToString("N0")
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center p-5">
                <i class="fas fa-box-open fa-4x text-muted mb-4"></i>
                <p class="h4 text-muted">Không có chi tiết mua hàng</p>
            </div>
        }

        <div class="card-footer d-flex justify-content-between align-items-center">
            <small class="text-muted">
                <i class="fas fa-info-circle me-2"></i>Chi tiết được xuất vào @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
            </small>
            <a href="@Url.Action("KhachHangThanThiet")" class="btn btn-outline-primary">
                <i class="fas fa-arrow-left me-2"></i>Quay lại danh sách
            </a>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css">
<style>
    body {
        background-color: #f4f6f9;
    }
</style>