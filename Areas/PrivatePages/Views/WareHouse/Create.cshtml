@model ShopTechNoLoGy.Models.NhapKho

@{
    ViewData["Title"] = "Nhập Kho Sản Phẩm";
}

<div class="container mt-5">
    <h2 class="text-center mb-4">Nhập Kho Sản Phẩm</h2>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <!-- Hiển thị lỗi nếu có lỗi trong ModelState -->
        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

        <div class="row">
            <!-- Mã Sản Phẩm -->
            <div class="col-md-6 mb-3">
                @Html.LabelFor(m => m.maSP, "Mã Sản Phẩm", new { @class = "form-label" })
                @Html.DropDownListFor(m => m.maSP, new SelectList(ViewBag.SanPhamList, "maSP", "tenSP"), "Chọn sản phẩm", new { @class = "form-select" })
                @Html.ValidationMessageFor(m => m.maSP, "", new { @class = "text-danger" })
            </div>

            <!-- Số Lượng Nhập -->
            <div class="col-md-6 mb-3">
                @Html.LabelFor(m => m.SoLuongNhap, "Số Lượng Nhập", new { @class = "form-label" })
                @Html.TextBoxFor(m => m.SoLuongNhap, new { @class = "form-control", @placeholder = "Số lượng nhập" })
                @Html.ValidationMessageFor(m => m.SoLuongNhap, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="row">
            <!-- Giá Nhập -->
            <div class="col-md-6 mb-3">
                @Html.LabelFor(m => m.GiaNhap, "Giá Nhập", new { @class = "form-label" })
                @Html.TextBoxFor(m => m.GiaNhap, new { @class = "form-control", @placeholder = "Giá nhập" })
                @Html.ValidationMessageFor(m => m.GiaNhap, "", new { @class = "text-danger" })
            </div>

            <!-- Tài Khoản -->
            <div class="col-md-6 mb-3">
                @Html.LabelFor(m => m.taiKhoan, "Tài Khoản", new { @class = "form-label" })
                <input type="text" class="form-control" value="@User.Identity.Name" readonly />
            </div>
        </div>

        <div class="row">
            <!-- Ghi Chú -->
            <div class="col-md-12 mb-3">
                @Html.LabelFor(m => m.GhiChu, "Ghi Chú", new { @class = "form-label" })
                @Html.TextBoxFor(m => m.GhiChu, new { @class = "form-control", @placeholder = "Ghi chú" })
            </div>
        </div>

        <div class="text-center">
            <input type="submit" value="Nhập Kho" class="btn btn-success btn-lg" />
        </div>
    }
</div>
